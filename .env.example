# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this to .env and fill in your values
# .env is gitignored and must NEVER be committed
#
# Generate a secure SECRET_KEY with:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker / Local DB ─────────────────────────────────────────────────────────
POSTGRES_USER=gameplatform
POSTGRES_PASSWORD=localpassword
POSTGRES_DB=gameplatform_dev
REDIS_PASSWORD=localpassword
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=localpassword

# ── MinIO (local object storage) ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── FastAPI ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://gameplatform:localpassword@localhost:5432/gameplatform_dev
DATABASE_URL_DIRECT=postgresql://gameplatform:localpassword@localhost:5432/gameplatform_dev
REDIS_URL=redis://:localpassword@localhost:6379
SECRET_KEY=replace-with-output-of--openssl-rand-hex-32
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# ── Object Storage ────────────────────────────────────────────────────────────
# STORAGE_PROVIDER controls which backend is used:
#   "s3"         — S3-compatible (MinIO locally, or any S3-compatible service)
#   "cloudinary" — Cloudinary (set CLOUDINARY_* vars below, leave S3 vars blank)

STORAGE_PROVIDER=s3

# S3-compatible (local MinIO defaults — leave as-is for local dev)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=gameplatform-assets
STORAGE_PUBLIC_URL=http://localhost:9000/gameplatform-assets
STORAGE_REGION=us-east-1

# Cloudinary (only needed when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Auth — Clerk ──────────────────────────────────────────────────────────────
# Get these from clerk.com → your application → API Keys
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_JWKS_URL=https://YOUR_CLERK_FRONTEND_API/.well-known/jwks.json
# Set to "true" to skip Clerk validation in local dev (never use in production)
DEV_BYPASS_AUTH=true

# ── Game config ───────────────────────────────────────────────────────────────
QUESTIONS_PER_SESSION=5
FUZZY_MATCH_THRESHOLD=0.8

# ── Admin panel ───────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# ── Error Tracking — Sentry ───────────────────────────────────────────────────
# Leave empty to disable
SENTRY_DSN=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Copy the block below into frontend/.env.local
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
VITE_API_URL=http://localhost:8000
VITE_STORAGE_PUBLIC_URL=http://localhost:9000/gameplatform-assets
